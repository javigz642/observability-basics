# Copia este archivo como .env y pega tus claves (NUNCA subas el .env a git)

# ── LangSmith · smith.langchain.com -> Settings -> API Keys ──
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=observability-basics

# ── LangFuse Cloud · cloud.langfuse.com -> Settings -> API Keys ──
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
